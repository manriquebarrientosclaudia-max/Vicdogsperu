@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string c) => ctrl == c ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Vicdogs Perú</title>
    <link rel="icon" type="image/png" href="~/img/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fredoka:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="cabecera">
        <div class="contenedor cabecera-fila">
            <a asp-controller="Home" asp-action="Index" class="logo-enlace"><img src="~/img/logo.png" alt="Vicdogs Perú" /></a>
            <div class="usuario">
                <span class="d-none d-sm-inline"><i class="bi bi-person-circle"></i> @(User.Identity?.Name)</span>
                <a asp-controller="Account" asp-action="CambiarClave" class="enlace-suave">Cambiar contraseña</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-dark">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </header>
    <nav class="navegacion">
        <div class="contenedor">
            <a asp-controller="Home" asp-action="Index" class="@Activo("Home")"><i class="bi bi-speedometer2"></i> Panel</a>
            <a asp-controller="Caninos" asp-action="Index" class="@Activo("Caninos")"><i class="bi bi-heart-fill"></i> Caninos</a>
            <a asp-controller="Tutores" asp-action="Index" class="@Activo("Tutores")"><i class="bi bi-people-fill"></i> Tutores</a>
            <a asp-controller="Redes" asp-action="Index" class="@Activo("Redes")"><i class="bi bi-instagram"></i> Redes</a>
            <a asp-controller="Recordatorios" asp-action="Index" class="@Activo("Recordatorios")"><i class="bi bi-bell-fill"></i> Recordatorios</a>
        </div>
    </nav>

    <main class="contenedor py-4">
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-dark d-flex align-items-center gap-2 mensaje-ok" role="status"><i class="bi bi-check-circle-fill"></i> @TempData["Ok"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="pie">Vicdogs Perú · Registro de caninos y tutores</footer>
    <script>
        // Botones «Copiar»: copian el texto de data-copiar al portapapeles
        document.addEventListener('click', function (e) {
            var b = e.target.closest('[data-copiar]');
            if (!b) return;
            var texto = b.getAttribute('data-copiar');
            function listo() {
                var original = b.innerHTML;
                b.innerHTML = '<i class="bi bi-check2"></i> Copiado';
                setTimeout(function () { b.innerHTML = original; }, 1500);
            }
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(texto).then(listo);
            } else {
                var ta = document.createElement('textarea');
                ta.value = texto; document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); listo(); } catch (err) { }
                document.body.removeChild(ta);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
