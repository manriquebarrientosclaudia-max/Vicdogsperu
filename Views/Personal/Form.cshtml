@model Empleado
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Agregar persona" : "Editar persona";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <h1 class="titulo">@(esNuevo ? "Agregar persona" : "Editar persona")</h1>
    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
</div>

<form asp-action="@(esNuevo ? "Create" : "Edit")" asp-route-id="@(esNuevo ? (int?)null : Model.Id)" method="post" class="panel-caja mx-auto" style="max-width:640px">
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Mirella Quispe" required autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Cargo" class="form-label"></label>
            <input asp-for="Cargo" class="form-control" placeholder="Ej. Adiestrador, Cuidadora, Recepción" />
        </div>
        <div class="col-md-6">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" inputmode="tel" />
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
            <div class="form-text">Si ya no trabaja, desmárcalo: deja de aparecer al tomar asistencia, pero se conserva su historial.</div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-azul">@(esNuevo ? "Agregar al personal" : "Guardar cambios")</button>
        </div>
    </div>
</form>
