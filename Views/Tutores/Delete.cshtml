@model Tutor
@{ ViewData["Title"] = "Eliminar a " + Model.Nombre; }
<div class="panel-caja mx-auto text-center" style="max-width:520px">
    <h1 class="titulo h3">¿Eliminar a @Model.Nombre?</h1>
    <p class="text-muted">Se borra solo la ficha del tutor. @(Model.Caninos.Any() ? "Sus perros (" + string.Join(", ", Model.Caninos.Select(x => x.Canino.Nombre)) + ") seguirán registrados, pero quedarán sin este tutor." : "No tiene perros asignados.")</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-dark">Sí, eliminar</button>
        </form>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-azul">Cancelar</a>
    </div>
</div>
