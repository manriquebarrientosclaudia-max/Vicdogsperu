@model List<Tutor>
@{ ViewData["Title"] = "Tutores"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="titulo">Tutores</h1>
        <p class="text-muted mb-0">@Model.Count @(Model.Count == 1 ? "tutor" : "tutores")@(string.IsNullOrWhiteSpace((string)ViewBag.Q) ? "" : " que coinciden con tu búsqueda").</p>
    </div>
    <a asp-action="Create" class="btn btn-azul"><i class="bi bi-plus-lg"></i> Nuevo tutor</a>
</div>

<form method="get" asp-action="Index" class="filtros mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label" for="q">Buscar por tutor, teléfono o perro</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" id="q" name="q" value="@ViewBag.Q" placeholder="Ej. Mirella, 987654321 o Iggy" />
            </div>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark flex-fill">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-dark">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="panel-caja vacio">No se encontraron tutores. Prueba otra búsqueda o registra uno nuevo.</div>
}
else
{
    <div class="tutores-grid">
    @foreach (var t in Model)
    {
        var wa = Ayudas.EnlaceWhatsApp(t.Telefono);
        var llamar = Ayudas.EnlaceLlamar(t.Telefono);
        var zonas = t.Caninos.Select(cx => cx.Canino.Distrito).Where(d => !string.IsNullOrEmpty(d)).Distinct().ToList();
        <article class="tutor-card">
            <header class="tutor-card-cabeza">
                <span class="avatar-iniciales avatar-grande" aria-hidden="true">@t.Iniciales</span>
                <div class="tutor-card-nombre">
                    <a asp-action="Details" asp-route-id="@t.Id" class="tutor-nombre-enlace">@t.Nombre</a>
                    <div class="small text-muted">
                        @if (zonas.Any()) { <span><i class="bi bi-geo-alt-fill"></i> @string.Join(", ", zonas)</span> }
                        @if (t.Cumpleanos.HasValue) { <span class="ms-2"><i class="bi bi-cake2-fill"></i> @t.Cumpleanos.Value.DiaYMes()</span> }
                        @if (!zonas.Any() && !t.Cumpleanos.HasValue) { <span>Sin zona ni cumpleaños</span> }
                    </div>
                </div>
                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-dark" aria-label="Editar a @t.Nombre"><i class="bi bi-pencil-fill"></i></a>
            </header>

            <div class="tutor-card-contacto">
                @if (llamar != null)
                {
                    <a href="@llamar" class="btn btn-sm btn-outline-dark"><i class="bi bi-telephone-fill"></i> @t.Telefono</a>
                    @if (wa != null) { <a href="@wa" target="_blank" rel="noopener" class="btn btn-sm btn-azul"><i class="bi bi-whatsapp"></i> WhatsApp</a> }
                }
                else { <span class="text-muted small">Sin teléfono</span> }
                <partial name="_RedesTutor" model="t" />
            </div>

            <div class="tutor-card-perros">
                @if (!t.Caninos.Any()) { <span class="text-muted small">Sin perros asignados</span> }
                @foreach (var x in t.Caninos.OrderBy(ct => ct.Canino.Nombre))
                {
                    var otros = x.Canino.Tutores.Where(o => o.TutorId != t.Id).Select(o => o.Tutor.Nombre).ToList();
                    <a asp-controller="Caninos" asp-action="Details" asp-route-id="@x.Canino.Id" class="perro-chip" title="@(otros.Any() ? "Lo comparte con " + string.Join(" y ", otros) : "Único tutor")">
                        <img src="@x.Canino.FotoOPlaceholder" alt="" loading="lazy" />
                        <span>@x.Canino.Nombre@if (otros.Any()) { <small class="d-block"><i class="bi bi-people-fill"></i> con @string.Join(" y ", otros)</small> }</span>
                    </a>
                }
            </div>
        </article>
    }
    </div>
}
